DATABASE_URL=postgresql://echomind:echomind@localhost:5432/echomind
# Runtime role for the API. Leave empty in dev to reuse DATABASE_URL; set it in any
# deployment so application code runs without DDL rights.
APP_DATABASE_URL=
JWT_SECRET=dev-only-change-me
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
JUDGE_MODEL=qwen2.5:7b-instruct
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
RERANKER=none            # none | bge
RERANKER_BASE_URL=
LLM_EXTRA_BODY=          # merged into every chat request, e.g. {"chat_template_kwargs":{"enable_thinking":false}}
LLM_STRUCTURED_OUTPUT=auto   # auto | json_schema | json_object | off
GATE_MIN_TOP_SCORE=0.45
ESCALATION_ENABLED=false
FRONTIER_BASE_URL=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
API_PORT=8080
MCP_PORT=8090
