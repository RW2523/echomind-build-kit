DATABASE_URL=postgresql://echomind:echomind@localhost:5432/echomind
# Runtime role for the API. Leave empty in dev to reuse DATABASE_URL; set it in any
# deployment so application code runs without DDL rights.
APP_DATABASE_URL=
# Passwordless one-click sign-in as a demo user. On automatically for a dev checkout
# (JWT_SECRET left at the default); set true to open it deliberately with a real secret.
DEMO_LOGIN_ENABLED=false
JWT_SECRET=dev-only-change-me
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
JUDGE_MODEL=qwen2.5:7b-instruct
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
RERANKER=none            # none | on  (any value but none/off enables the endpoint)
# Which model the rerank service loads. Qwen3-Reranker scores the log-odds of "yes",
# so its scores are calibrated around zero — positive means "this answers the question"
# — and retrieval trusts that sign to drop the rest. bge-reranker-large is the lighter
# alternative: ~2s/query faster, but its logits are negative throughout and it could not
# separate a document that answers the question from one that merely mentions it.
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
RERANKER_BASE_URL=
LLM_EXTRA_BODY=          # merged into every chat request, e.g. {"chat_template_kwargs":{"enable_thinking":false}}
LLM_STRUCTURED_OUTPUT=auto   # auto | json_schema | json_object | off
GATE_MIN_TOP_SCORE=0.45
ESCALATION_ENABLED=false
FRONTIER_BASE_URL=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
API_PORT=8080
MCP_PORT=8090
