{
  "name": "echomind-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:units && npm run test:render && npm run test:dom",
    "test:units": "node --test test/*.test.ts",
    "test:render": "esbuild --bundle --platform=node --format=cjs --jsx=automatic --outfile=.test-build/render.smoke.test.cjs test/render.smoke.tsx && node --test .test-build/render.smoke.test.cjs",
    "test:dom": "esbuild --bundle --platform=node --format=cjs --jsx=automatic --external:jsdom --outfile=.test-build/interaction.dom.test.cjs test/interaction.dom.tsx && node --test --test-force-exit .test-build/interaction.dom.test.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
