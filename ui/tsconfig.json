{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  // The tests are compiled beside the code they test. Without this a test could call a
  // function with arguments of the wrong shape and still pass, which is exactly the kind
  // of test that goes green while the screen stays broken. node:test and node:assert are
  // declared in test/node-test.d.ts rather than pulled in with @types/node, which would
  // put Node's globals into the compile of a browser application.
  "include": ["src", "test"]
}
